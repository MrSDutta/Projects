# Domain Configuration
DOMAIN_NAME=yourdomain.com
SUBDOMAIN_1=automation  # Will become: automation.yourdomain.com (for n8n)
SUBDOMAIN_2=dashboard   # Will become: dashboard.yourdomain.com (for Metabase)

# SSL Email (for Let's Encrypt notifications)
SSL_EMAIL=your-email@example.com

# PostgreSQL Database
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_123456
POSTGRES_DB=n8n

# n8n Encryption & Security
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=GENERATE_RANDOM_32_CHAR_STRING_HERE
N8N_USER_MANAGEMENT_JWT_SECRET=GENERATE_RANDOM_32_CHAR_STRING_HERE

# n8n Basic Auth (login credentials)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Timezone
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# Optional: Traefik Dashboard Auth
# Generate password hash with: echo $(htpasswd -nb admin password) | sed -e s/\\$/\\$\\$/g
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=HTPASSWD_ENCODED_PASSWORD_HERE
