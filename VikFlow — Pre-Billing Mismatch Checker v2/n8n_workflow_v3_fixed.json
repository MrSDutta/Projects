      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO webhook_log (source, payload) VALUES ('billing_webhook', '{{ JSON.stringify($json) }}'::jsonb); INSERT INTO draft_invoices (invoice_id, account_name, line_item, billed_unit_price, quantity, remarks, entry_method) VALUES ('{{ $json.invoice_id }}', '{{ $json.account_name }}', '{{ $json.line_item }}', {{ $json.billed_unit_price }}, {{ $json.quantity || 1 }}, {{ $json.remarks ? \"'\" + $json.remarks + \"'\" : 'NULL' }}, 'webhook');",
        "options": {}
      },
