        "query": "INSERT INTO webhook_log (source, payload) VALUES ('crm_pricing_webhook', '{{ JSON.stringify($json) }}'::jsonb); INSERT INTO agreed_pricing (account_name, line_item, agreed_unit_price, source_reference, remarks, entered_by, entry_method) VALUES ('{{ $json.account_name }}', '{{ $json.line_item }}', {{ $json.agreed_unit_price }}, {{ $json.source_reference ? \"'\" + $json.source_reference + \"'\" : 'NULL' }}, {{ $json.remarks ? \"'\" + $json.remarks + \"'\" : 'NULL' }}, {{ $json.entered_by ? \"'\" + $json.entered_by + \"'\" : 'NULL' }}, 'webhook');",
        "options": {}
      },
      "id": "026e039e-cfed-4101-a8ec-05113acb460c",
      "name": "Store Agreed Pricing",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        320,
        3056
      ],
      "credentials": {
        "postgres": {
          "id": "XvU8srQhM0siFrj7",
          "name": "Postgres account vikflow"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT di.id AS draft_id, di.invoice_id, di.account_name, di.line_item, di.billed_unit_price, di.quantity, di.remarks AS invoice_remarks, ap.id AS agreed_id, ap.agreed_unit_price, ap.source_reference, ap.remarks AS pricing_remarks, ap.entered_by, ABS(di.billed_unit_price - COALESCE(ap.agreed_unit_price, 0)) AS deviation, CASE WHEN ap.id IS NULL THEN 'unmatched' WHEN ABS(di.billed_unit_price - ap.agreed_unit_price) <= 0.01 THEN 'clean' ELSE 'flagged' END AS check_result FROM draft_invoices di LEFT JOIN agreed_pricing ap ON LOWER(TRIM(di.account_name)) = LOWER(TRIM(ap.account_name)) AND LOWER(TRIM(di.line_item)) = LOWER(TRIM(ap.line_item)) AND (ap.effective_until IS NULL OR ap.effective_until >= di.invoice_date) WHERE di.status = 'pending_review';",
        "options": {}
      },
      "id": "044a0665-5c45-47e0-94ea-a166d2b59db0",
      "name": "Compare: Billed vs Agreed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        544,
        2688
      ],
      "credentials": {
        "postgres": {
          "id": "XvU8srQhM0siFrj7",
          "name": "Postgres account vikflow"
        }
      },
      "notes": "Tolerance hardcoded at 0.01. Change the number in the query to adjust."
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.check_result }}",
              "operation": "equals",
              "value2": "flagged"
            }
          ]
        }
      },
      "id": "3740d7f9-d73a-4f2c-b1a0-63c49191f660",
      "name": "Filter: Flagged Only",
