# ── Copy this file to .env and fill in all values ─────────
# cp .env.example .env
# nano .env

# ── Domain ────────────────────────────────────────────────
DOMAIN_NAME=clientdomain.com
SUBDOMAIN_1=n8n
SUBDOMAIN_2=dashboard
SUBDOMAIN_3=crm
SSL_EMAIL=client@email.com

# ── Postgres ───────────────────────────────────────────────
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=n8n

# ── n8n ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGE_ME_32_CHAR_RANDOM_STRING
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin@clientdomain.com
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Timezone ──────────────────────────────────────────────
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
